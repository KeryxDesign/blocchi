---
// S9 · Prezzo: prezzo, come si paga, perché costa così. Max 3 card (nome, prezzo, per chi ≤ 12,
// 2-5 voci di differenza ≤ 8, CTA ≤ 5; ciò che è comune sta in S7). Unica sede di scadenza e timer
// (slot "scadenza"). Un solo bottone oro (pacchetto con evidenza), gli altri livello 2.
// v54 (Florbo 28/10): il prezzo sta in un box suo (fondo e filo distinti, prezzo grande, «poi X €» dentro);
// «incluso» = riga in testa all'elenco che dice quale pacchetto precedente è compreso («Tutto il pacchetto X, più:»).
// v61 (Florbo 28/10 14:00): ordine nome → per chi → voci → prezzo → bottone; il box prezzo va in fondo, allineato fra le card.
// v62 (Florbo 28/10 14:05 «titolo, sottotitolo e titolo dell'elenco troppo simili»): per chi in tondo normale;
// «Tutto il pacchetto X, più:» = etichetta piccola maiuscola oro con filo sopra.
// v64 (Florbo 28/10 14:17): prezzo senza riquadro, grande, centrato, in --coral-ink.
// Telefono: card a scorrimento con la successiva visibile a metà (#200 d); computer: 3 card affiancate.
import KxSezione from "./KxSezione.astro";
import KxTesta from "./KxTesta.astro";
import { tetto, quante, type Azione, type Fondo } from "./scheletro";

interface Pacchetto { nome: string; prezzo: string; nota?: string; perChi: string; incluso?: string; voci: string[]; cta: Azione; evidenza?: boolean; }
interface Props { titolo: string; pacchetti: Pacchetto[]; perche: string; pagamento: string; fondo?: Fondo; id?: string; }

const S = "S9 Prezzo";
const { titolo, perche, pagamento, fondo = "bianco", id } = Astro.props;
const pacchetti = quante(S, "pacchetti", Astro.props.pacchetti, 1, 3);
if (pacchetti.filter((p) => p.evidenza).length > 1) throw new Error(`[scheletro #204] ${S}: un solo pacchetto in evidenza (un solo bottone oro).`);
pacchetti.forEach((p, i) => {
  tetto(S, `pacchetto ${i + 1} nome`, p.nome, 4);
  tetto(S, `pacchetto ${i + 1} nota sotto il prezzo`, p.nota, 8, false);
  tetto(S, `pacchetto ${i + 1} per chi`, p.perChi, 12);
  tetto(S, `pacchetto ${i + 1} incluso`, p.incluso, 8, false);
  quante(S, `pacchetto ${i + 1} voci`, p.voci, 2, 5).forEach((v, j) => tetto(S, `pacchetto ${i + 1} voce ${j + 1}`, v, 8));
  tetto(S, `pacchetto ${i + 1} CTA`, p.cta.testo, 5);
});
tetto(S, "perché costa così", perche, 30);
tetto(S, "come si paga", pagamento, 20);
// Link esterni (es. WhatsApp) in una scheda nuova; wa.me porta data-lt-alt per UTM e Plausible.
const est = (h: string) => /^https?:/.test(h) ? { target: "_blank", rel: "noopener noreferrer", ...(h.includes("wa.me/") ? { "data-lt-alt": "whatsapp" } : {}) } : {};
---

<KxSezione fondo={fondo} id={id} etichetta="Prezzo">
  <KxTesta sezione={S} titolo={titolo} maxTitolo={8} />
  {Astro.slots.has("scadenza") && <div class="kxz-scad"><slot name="scadenza" /></div>}
  <ul class="kxv-nastro kxz" tabindex="0" aria-label="Pacchetti, scorri per confrontarli">
    {pacchetti.map((p) => (
      <li>
        <div class:list={["kxv-card kxz-card", { "kxz-ev": p.evidenza }]}>
          <h3 class="kxv-h3">{p.nome}</h3>
          <p class="kxv-compatto kxz-chi" set:html={p.perChi} />
          {p.incluso && <p class="kxv-compatto kxz-incl" set:html={p.incluso} />}
          <ul class="kxz-voci">{p.voci.map((v) => <li class="kxv-compatto" set:html={v} />)}</ul>
          <div class="kxz-box">
            <p class="kxz-prezzo" set:html={p.prezzo} />
            {p.nota && <p class="kxz-nota" set:html={p.nota} />}
          </div>
          {p.evidenza
            ? <a href={p.cta.href} {...est(p.cta.href)} class="kxv-cta btn-gold kxz-cta">{p.cta.testo}</a>
            : <a href={p.cta.href} {...est(p.cta.href)} class="kxv-cta kxz-cta kxz-sec">{p.cta.testo}</a>}
        </div>
      </li>
    ))}
  </ul>
  <div class="kxv-stretto kxz-note">
    <p class="kxv-testo" set:html={perche} />
    <p class="kxv-testo" set:html={pagamento} />
  </div>
</KxSezione>

<style>
  .kxz-scad { margin: -16px auto 24px; text-align: center; }
  .kxz-card { width: min(300px, calc(100vw - 96px)); height: 100%; display: flex; flex-direction: column; gap: 8px; }
  .kxz-ev { border: 2px solid hsl(var(--gold)); }
  .kxz-box { margin: auto 0 8px; padding: var(--kx-s3) 0 0; border-top: 1px solid hsl(var(--kx-filo)); display: grid; gap: var(--kx-s0); text-align: center; justify-items: center; }
  
  .kxz-nota { font-size: 15px; line-height: 1.45; color: hsl(var(--foreground)); font-weight: 600; }
  .kxz-incl { margin-top: 12px; padding-top: 12px; border-top: 1px solid hsl(var(--kx-filo)); font-size: 14px; line-height: 1.4; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: hsl(var(--gold-ink)); }
  .kxz-prezzo { font-family: theme('fontFamily.display'); font-weight: 800; font-size: 52px; line-height: 1.05; color: hsl(var(--coral-ink)); }
  .kxz-chi { margin-top: 4px; font-weight: 400; }
  .kxz-voci { list-style: none; margin: 4px 0 16px; padding: 0; display: grid; gap: 8px; }
  .kxz-voci li { position: relative; padding-left: 1.6rem; }
  .kxz-voci li::before { content: "✓"; position: absolute; left: 0; font-weight: 700; color: hsl(var(--gold-ink)); }
  .kxz-cta { width: 100%; }
  .kxz-sec { border: 2px solid hsl(var(--primary)); color: hsl(var(--primary)); background: transparent; }
  .kxz-note { display: grid; gap: 12px; margin-top: 24px; }
  @media (min-width: 768px) {
    .kxz { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; overflow: visible; margin: 0; padding: 0; }
    .kxz-card { width: auto; }
  }
</style>
