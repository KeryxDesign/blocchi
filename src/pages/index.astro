---
// Catalogo interno dei blocchi di vendita (S0-S13, ratifica #204). Non indicizzato, non linkato dal sito.
// Ogni blocco è un iframe verso /blocchi/[id]/ così i breakpoint rispondono alla larghezza vera: 390 telefono, 1440 computer.
import Layout from "../layouts/Base.astro";
import { BLOCCHI } from "../data/blocchi-vendita";
const B = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<Layout title="Catalogo blocchi | Keryx Design">
  <main class="cat">
    <header class="cat-t">
      <h1>Blocchi di vendita</h1>
      <p>Uno per sezione dello scheletro fisso (ratifica #204). Testi di esempio. Codice in <code>src/components/vendita/</code>.</p>
      <nav aria-label="Sezioni">{BLOCCHI.map((b) => <a href={`#${b.id}`}>{b.sezione}</a>)}</nav>
    </header>
    {BLOCCHI.map((b) => (
      <section class="cat-b" id={b.id}>
        <h2><span>{b.sezione}</span> {b.nome}</h2>
        <p class="cat-m"><code>{b.componente}</code> · {b.cosa}</p>
        <p class="cat-m">Tetti: {b.tetti} · Usato in: {b.usatoIn} · <a href={`${B}/${b.id}/`} target="_blank">Apri a schermo intero</a></p>
        <div class="cat-v">
          <figure class="cat-tel"><figcaption>Telefono 390</figcaption><div class="cat-f"><iframe src={`${B}/${b.id}/`} title={`${b.nome}, telefono`} loading="lazy"></iframe></div></figure>
          <figure class="cat-pc"><figcaption>Computer 1440</figcaption><div class="cat-f"><iframe src={`${B}/${b.id}/`} title={`${b.nome}, computer`} loading="lazy"></iframe></div></figure>
        </div>
      </section>
    ))}
  </main>
</Layout>

<style>
  .cat { max-width: 1280px; margin: 0 auto; padding: 24px 16px 80px; font-family: system-ui, sans-serif; color: #1a1a1a; }
  .cat-t h1 { font-size: 32px; font-weight: 800; }
  .cat-t nav { position: sticky; top: 0; background: #fff; padding: 12px 0; display: flex; flex-wrap: wrap; gap: 8px; z-index: 5; border-bottom: 1px solid #ddd; }
  .cat-t nav a { padding: 4px 10px; border: 1px solid #ccc; border-radius: 6px; text-decoration: none; color: inherit; font-size: 15px; }
  .cat-b { margin-top: 56px; scroll-margin-top: 70px; }
  .cat-b h2 { font-size: 24px; font-weight: 800; }
  .cat-b h2 span { background: #1a1a1a; color: #fff; border-radius: 6px; padding: 2px 8px; margin-right: 6px; font-size: 18px; }
  .cat-m { margin-top: 6px; font-size: 15px; color: #444; }
  .cat-v { display: flex; flex-wrap: wrap; gap: 32px; margin-top: 16px; align-items: flex-start; }
  figure { margin: 0; }
  figcaption { font-size: 14px; font-weight: 600; margin-bottom: 6px; }
  .cat-f { border: 1px solid #bbb; border-radius: 10px; overflow: hidden; background: #eee; }
  .cat-tel .cat-f { width: 390px; max-width: 100%; }
  .cat-tel iframe { width: 390px; height: 844px; border: 0; display: block; }
  .cat-pc .cat-f { width: 800px; height: 450px; max-width: 100%; }
  .cat-pc iframe { width: 1440px; height: 810px; border: 0; transform: scale(.5556); transform-origin: top left; display: block; }
  @media (max-width: 860px) { .cat-pc { display: none; } }
</style>
